{
  "name": "cyber-forge-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build && node scripts/single-file.mjs",
    "build:yandex": "vite build --mode yandex && node scripts/zip.mjs dist-yandex cyber-forge-yandex.zip",
    "build:server": "vite build --mode server",
    "build:vercel": "vite build --mode vercel",
    "server": "node server/server.mjs",
    "pack:server": "vite build --mode server && node scripts/pack-server.mjs",
    "preview": "vite preview --host",
    "test": "node --test \"tests/*.test.js\"",
    "android": "npm run build && npx cap add android && npx cap sync android",
    "android:sync": "npm run build && npx cap sync android"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0"
  }
}
